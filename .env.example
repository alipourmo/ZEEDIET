# Copy to .env for local development. Never commit .env.
# Production values are set in Vercel project environment variables, not in this file.

APP_NAME=ZeeDiet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Asia/Tehran time zone and Persian UI (spec section 3).
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8, utf8mb4 (spec section 3). The SQLite default is only for quick local checks.
# The Vercel preview runs without a database.
DB_CONNECTION=sqlite

# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=zeediet
# DB_USERNAME=zeediet
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

# SMS (spec section 3). LogGateway is for local/testing only; OTP codes are redacted in its log.
SMS_DRIVER=log
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# Clinic settings (config/clinic.php).
CLINIC_NAME=ZeeDiet
CLINIC_REMINDER_HOURS_BEFORE=24

# Backups (spec section 10.8). Key used to encrypt backup archives; set in the environment only.
BACKUP_ENCRYPTION_KEY=
BACKUP_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
