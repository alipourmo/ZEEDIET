# Copy to .env and fill in. Never commit .env.

APP_NAME=ZeeDiet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Asia/Tehran and Persian UI (section 3).
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL 8, utf8mb4 (section 3). Use a least-privilege DB user in production (section 16).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zeediet
DB_USERNAME=zeediet
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=database
CACHE_STORE=database

# SMS (section 3, open question 2). LogGateway writes to storage/logs/sms.log in local/testing only.
SMS_DRIVER=log
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# Clinic settings (config/clinic.php).
CLINIC_NAME=ZeeDiet
CLINIC_REMINDER_HOURS_BEFORE=24

# Backups (section 10.8). Key used to encrypt backup archives. Generate with: php artisan backup:key
BACKUP_ENCRYPTION_KEY=
BACKUP_DISK=local
